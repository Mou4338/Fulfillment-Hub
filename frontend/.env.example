# --- Local development ---
# Where the FastAPI backend runs
NEXT_PUBLIC_API_URL=http://localhost:8000
# Business time zone used for all displayed times
NEXT_PUBLIC_TZ=Asia/Kolkata

# --- Vercel deployment ---
# Set BACKEND_URL instead of NEXT_PUBLIC_API_URL. The site then proxies /api/* to the backend
# on its own domain, so no CORS setup is needed.
# BACKEND_URL=https://fulfillment-hub-api.vercel.app
