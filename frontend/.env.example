# --- Local development (npm run dev) ---
# Where the FastAPI backend runs
NEXT_PUBLIC_API_URL=http://localhost:8000
# Business time zone used for all displayed times
NEXT_PUBLIC_TZ=Asia/Kolkata

# --- Vercel ---
# Nothing to set. vercel.json serves the frontend and the backend on one domain,
# and the app calls /api/... on that same domain automatically.
